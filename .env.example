APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database Configuration (Hosting Server: MySQL / MariaDB)
# Local development uses sqlite:
DB_CONNECTION=sqlite
# Production Hosting (cPanel / VPS / Shared Hosting):
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=u123456_nusarattan
# DB_USERNAME=u123456_nusauser
# DB_PASSWORD=your_hosting_database_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ========================================================
# File Storage: Supabase Storage Only (S3-compatible)
# ========================================================
# Set to 'supabase' when ready to store uploads in Supabase:
FILESYSTEM_DISK=local

# In Supabase Dashboard: Project Settings -> Storage -> S3 Access Keys
# 1. Click 'New Access Key' to generate Access Key ID and Secret Access Key
# 2. S3 Endpoint format: https://<project-ref>.supabase.co/storage/v1/s3
# 3. Create a public bucket in Supabase Storage (e.g. 'nusarattan')
SUPABASE_S3_KEY=
SUPABASE_S3_SECRET=
SUPABASE_S3_REGION=us-east-1
SUPABASE_BUCKET=nusarattan
SUPABASE_S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
SUPABASE_PUBLIC_URL=https://<project-ref>.supabase.co/storage/v1/object/public/nusarattan

MAIL_TO_ADDRESS=nusarattanid@gmail.com

